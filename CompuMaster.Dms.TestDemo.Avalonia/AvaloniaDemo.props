<Project>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CompuMaster.Dms.TestDemo.Avalonia</RootNamespace>
    <Configurations>Debug;Release;CI_CD</Configurations>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationIcon>$(MSBuildThisFileDirectory)../CompuMaster.Dms.BrowserUI/favicon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../CompuMaster.Dms.BrowserUI.Avalonia/CompuMaster.Dms.BrowserUI.Avalonia.csproj" />
    <Compile Include="Program.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DemoApplication.cs" Link="Shared/DemoApplication.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DemoDefinition.cs" Link="Shared/DemoDefinition.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DemoInputBuffer.cs" Link="Shared/DemoInputBuffer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DemoScopevisioSelection.cs" Link="Shared/DemoScopevisioSelection.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DemoLoginWindow.cs" Link="Shared/DemoLoginWindow.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DemoText.cs" Link="Shared/DemoText.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DemoDmsProvider.cs" Link="Shared/DemoDmsProvider.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../CompuMaster.Dms.TestDemo.WebDav/DemoStrings*.resx" Link="%(Filename)%(Extension)">
      <ManifestResourceName>CompuMaster.Dms.TestDemo.Avalonia.%(Filename)</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
