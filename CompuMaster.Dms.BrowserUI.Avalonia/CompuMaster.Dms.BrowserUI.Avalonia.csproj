<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Configurations>Debug;Release;CI_CD</Configurations>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <PackageId>CompuMaster.Dms.BrowserUI.Avalonia</PackageId>
    <RootNamespace>CompuMaster.Dms.BrowserUI.Avalonia</RootNamespace>
    <AssemblyName>CompuMaster.Dms.BrowserUI.Avalonia</AssemblyName>
    <Authors>Jochen Wezel</Authors>
    <Company>CompuMaster GmbH</Company>
    <Product>CompuMaster.Dms</Product>
    <Copyright>2019-2026 CompuMaster GmbH</Copyright>
    <Description>Provider-independent DMS browser dialogs and controls for Avalonia on Windows, macOS and Linux. Includes file and folder selection, transfers, sharing, version history and instance selection.</Description>
    <PackageTags>DmsBrowser Avalonia Desktop CrossPlatform NextCloud OwnCloud CenterDevice Scopevisio Teamwork WebDAV API</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo_64x64.png</PackageIcon>
    <RepositoryUrl>https://github.com/CompuMasterGmbH/CompuMaster.Dms</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/CompuMasterGmbH/CompuMaster.Dms</PackageProjectUrl>
    <PackageReleaseNotes>Initial Avalonia BrowserUI package: reusable browser control and file/folder dialogs, sharing and external links, recursive transfers, version history, instance selection, localized/RTL UI, native file-type icons and dedicated desktop demos. Received-sharing provenance remains a separate follow-up: https://github.com/CompuMasterGmbH/CompuMaster.Dms/issues/150.</PackageReleaseNotes>
    <NeutralLanguage>en</NeutralLanguage>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <ProjectReference Include="../CompuMaster.Dms.Providers/CompuMaster.Dms.Providers.vbproj" />
    <EmbeddedResource Include="../CompuMaster.Dms.BrowserUI/UiStrings*.resx" Link="%(Filename)%(Extension)" />
    <AvaloniaResource Include="../CompuMaster.Dms.BrowserUI/Resources/*.png" Link="Assets/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../CompuMaster.Dms.BrowserUI/favicon.ico" Link="Assets/favicon.ico" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../CompuMaster.Dms.BrowserUI/logo_64x64.png" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="CompuMaster.Dms.Test.BrowserUI.Avalonia" />
    <InternalsVisibleTo Include="CompuMaster.Dms.Test.BrowserUI.Parity" />
    <InternalsVisibleTo Include="CompuMaster.Dms.Test.FileIconProbe" />
  </ItemGroup>
</Project>
