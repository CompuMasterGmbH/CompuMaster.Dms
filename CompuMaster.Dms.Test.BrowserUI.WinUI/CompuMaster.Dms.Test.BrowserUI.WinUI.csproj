<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>../CompuMaster.Dms.TestDemo.WinUI/app.manifest</ApplicationManifest>
    <ApplicationIcon>../CompuMaster.Dms.BrowserUI/favicon.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
    <Configurations>Debug;Release;CI_CD</Configurations>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN;DMS_WINUI</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DmsDocumentationScreenshots)' == 'true'">
    <DefineConstants>$(DefineConstants);DMS_DOCUMENTATION_SCREENSHOTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="NUnitLite" Version="4.6.1" />
    <ProjectReference Include="../CompuMaster.Dms.BrowserUI.WinUI/CompuMaster.Dms.BrowserUI.WinUI.csproj" />
    <ProjectReference Include="../CompuMaster.Dms.BrowserUI/CompuMaster.Dms.BrowserUI.vbproj" />
    <ProjectReference Include="../CompuMaster.Dms.Test.WinUI.Notice/CompuMaster.Dms.Test.WinUI.Notice.vbproj" />
    <Compile Include="../CompuMaster.Dms.TestDemo.Avalonia/DemoDefinition.cs" Link="DemoDefinition.cs" />
    <Compile Include="../CompuMaster.Dms.TestDemo.Avalonia/DemoInputBuffer.cs" Link="DemoInputBuffer.cs" />
    <Compile Include="../CompuMaster.Dms.TestDemo.Avalonia/DemoScopevisioSelection.cs" Link="DemoScopevisioSelection.cs" />
    <Compile Include="../CompuMaster.Dms.TestDemo.WinUI/DemoLoginWindow.cs" Link="DemoLoginWindow.cs" />
    <Compile Include="../CompuMaster.Dms.TestDemo.Avalonia/DemoText.cs" Link="DemoText.cs" />
    <Compile Include="../CompuMaster.Dms.Test.BrowserUI.Parity/DocumentationScreenshotData.cs" Link="DocumentationScreenshotData.cs" />
    <Compile Include="../CompuMaster.Dms.TestDemo.Avalonia/DemoDmsProvider.cs" Link="DemoDmsProvider.cs" />
    <EmbeddedResource Include="../CompuMaster.Dms.TestDemo.WebDav/DemoStrings*.resx" Link="%(Filename)%(Extension)">
      <ManifestResourceName>CompuMaster.Dms.TestDemo.WinUI.%(Filename)</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../CompuMaster.Dms.Test.BrowserUI.Avalonia/DiagnosticsDetailsTests.cs" Link="DiagnosticsDetailsTests.cs" />
    <Compile Include="../CompuMaster.Dms.Test.BrowserUI.Avalonia/ReceivedSharingTests.cs" Link="ReceivedSharingTests.cs" />
    <Compile Include="../CompuMaster.Dms.Test.BrowserUI.Avalonia/RefreshSelectionTests.cs" Link="RefreshSelectionTests.cs" />
    <Compile Include="../CompuMaster.Dms.Test.BrowserUI.Avalonia/BrowserCustomizationTests.cs" Link="BrowserCustomizationTests.cs" />
    <Compile Include="../CompuMaster.Dms.Test.BrowserUI.Avalonia/RefreshSelectionUiTests.cs" Link="RefreshSelectionUiTests.cs" />
  </ItemGroup>
</Project>
