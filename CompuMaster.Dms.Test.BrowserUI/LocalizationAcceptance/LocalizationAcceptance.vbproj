<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <RootNamespace>CompuMaster.Dms.Test.BrowserUI</RootNamespace>
    <AssemblyName>CompuMaster.Dms.Test.BrowserUI</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <IsTestProject>true</IsTestProject>
    <Configurations>Debug;Release;CI_CD</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.7" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../DevelopmentGuiTestSession.vb" Link="DevelopmentGuiTestSession.vb" />
    <Compile Include="../UiTestDispatcher.vb" Link="UiTestDispatcher.vb" />
    <Compile Include="../LocalizedLayoutAcceptanceTest.vb" Link="LocalizedLayoutAcceptanceTest.vb" />
    <Compile Include="../LocalizedFontAcceptanceTest.vb" Link="LocalizedFontAcceptanceTest.vb" />
    <Compile Include="../LocalizedMessageAcceptanceTest.vb" Link="LocalizedMessageAcceptanceTest.vb" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../CompuMaster.Dms.BrowserUI/CompuMaster.Dms.BrowserUI.vbproj" />
    <ProjectReference Include="../../CompuMaster.Dms.TestDemo.WebDav/CompuMaster.Dms.TestDemo.WebDav.vbproj" />
    <ProjectReference Include="../../CompuMaster.Dms.TestDemo.OwnCloudClassic/CompuMaster.Dms.TestDemo.OwnCloudClassic.vbproj" />
    <ProjectReference Include="../../CompuMaster.Dms.TestDemo.Nextcloud/CompuMaster.Dms.TestDemo.Nextcloud.vbproj" />
    <ProjectReference Include="../../CompuMaster.Dms.TestDemo.ScopevisioTeamwork/CompuMaster.Dms.TestDemo.ScopevisioTeamwork.vbproj" />
  </ItemGroup>
</Project>
